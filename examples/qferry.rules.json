{
  "version": "example-2026-05-12",
  "defaultGroupId": "review",
  "groups": [
    {
      "id": "archive",
      "label": "Archive candidates"
    },
    {
      "id": "review",
      "label": "Needs review"
    }
  ],
  "rules": [
    {
      "id": "newsletter-sender",
      "groupId": "archive",
      "match": {
        "fromIncludes": "newsletter@"
      },
      "priority": {
        "bucketId": "bulk",
        "reason": "Configured newsletter sender rule",
        "confidence": "medium",
        "weight": 40,
        "nextAction": "Review sample, then archive or move with a confirmed plan"
      }
    },
    {
      "id": "digest-subject",
      "groupId": "archive",
      "match": {
        "subjectIncludes": "digest"
      },
      "priority": {
        "bucketId": "bulk",
        "reason": "Configured digest subject rule",
        "confidence": "medium",
        "weight": 35,
        "nextAction": "Review recurrence and archive if expected"
      }
    },
    {
      "id": "block-known-junk-domain",
      "groupId": "archive",
      "match": {
        "fromIncludes": "known-junk.example"
      },
      "priority": {
        "bucketId": "bulk",
        "reason": "Configured known junk sender rule",
        "confidence": "high",
        "weight": 85,
        "nextAction": "Move to Junk only after explicit confirmation"
      }
    }
  ]
}
